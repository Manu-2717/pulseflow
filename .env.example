DATABASE_URL="postgresql://pulseflow:replace-me@localhost:5432/pulseflow?schema=public"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
BETTER_AUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate-a-long-random-secret"
# Optional Google sign-in. Create OAuth credentials for /api/auth/callback/google on your public domain.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional GitHub OAuth. Callback: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional Apple OAuth. Requires an Apple Developer membership and HTTPS callback.
# Store the .p8 key with literal \n line breaks in this environment variable.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
# Optional structured AI briefs.
OPENAI_API_KEY=""
# Configure SMTP before inviting real users. It enables email verification and password recovery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PulseFlow <hello@example.com>"
