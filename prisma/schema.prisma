generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatarColor String? @default("#8ee6ae")
  specialty String? @default("General")
  sessions Session[]
  accounts Account[]
  memberships Membership[]
  tasks Task[]
  threads IssueThread[]
  comments Comment[]
  invitesCreated Invite[]
  aiBriefQuotas AiBriefQuota[]
  timeEntries TimeEntry[]
  @@map("user")
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("account")
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}

model Workspace {
  id String @id @default(cuid())
  name String
  slug String @unique
  nextTaskNumber Int @default(1)
  createdAt DateTime @default(now())
  members Membership[]
  tasks Task[]
  threads IssueThread[]
  invites Invite[]
  projects Project[]
  documents WorkspaceDocument[]
  goals Goal[]
  automations AutomationRule[]
  sprints Sprint[]
  customFields CustomField[]
}

model Project {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  color String @default("#57a76a")
  createdAt DateTime @default(now())
  tasks Task[]
  @@index([workspaceId])
}

model Sprint {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  startDate DateTime
  endDate DateTime
  goal String @default("")
  createdAt DateTime @default(now())
  tasks Task[]
  @@index([workspaceId,startDate])
}

model CustomField {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  type String
  options Json?
  createdAt DateTime @default(now())
  values TaskFieldValue[]
  @@unique([workspaceId,name])
}

model TaskFieldValue {
  id String @id @default(cuid())
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldId String
  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value String
  @@unique([taskId,fieldId])
  @@index([fieldId])
}

model WorkspaceDocument {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  content String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId])
}

model Goal {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  target Int
  current Int @default(0)
  dueDate DateTime?
  createdAt DateTime @default(now())
  @@index([workspaceId])
}

model AutomationRule {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enabled Boolean @default(true)
  trigger String
  action String
  createdAt DateTime @default(now())
  @@unique([workspaceId,trigger,action])
}

model AiBriefQuota {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStart DateTime
  count Int @default(0)
  @@unique([userId,windowStart])
}

model Membership {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role String @default("MEMBER")
  joinedAt DateTime @default(now())
  @@unique([workspaceId,userId])
  @@index([userId])
}

model Invite {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  role String @default("MEMBER")
  expiresAt DateTime
  maxUses Int @default(10)
  useCount Int @default(0)
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  @@index([workspaceId])
}

model Task {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code String
  title String
  description String
  priority String
  estimatedPts Int
  status String
  assigneeId String?
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  threads IssueThread[]
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  startDate DateTime?
  dueDate DateTime?
  subtasks Subtask[]
  timeEntries TimeEntry[]
  predecessors TaskDependency[] @relation("DependencyTarget")
  successors TaskDependency[] @relation("DependencySource")
  sprintId String?
  sprint Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  fieldValues TaskFieldValue[]
  recurrence String?
  recurrenceSourceId String? @unique
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@unique([workspaceId,code])
  @@index([workspaceId,status])
  @@index([workspaceId,assigneeId])
}

model Subtask {
  id String @id @default(cuid())
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title String
  done Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([taskId])
}

model TaskDependency {
  id String @id @default(cuid())
  taskId String
  task Task @relation("DependencyTarget", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn Task @relation("DependencySource", fields: [dependsOnId], references: [id], onDelete: Cascade)
  @@unique([taskId,dependsOnId])
}

model TimeEntry {
  id String @id @default(cuid())
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes Int
  note String @default("")
  createdAt DateTime @default(now())
  @@index([taskId,createdAt])
  @@index([userId,createdAt])
}

model IssueThread {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title String
  category String
  status String @default("OPEN")
  aiTldr String?
  aiRootCause String?
  aiNextSteps String?
  aiGeneratedAt DateTime?
  pinnedCommentId String?
  taskId String
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  comments Comment[]
  createdAt DateTime @default(now())
  @@index([workspaceId,taskId])
}

model Comment {
  id String @id @default(cuid())
  content String
  codeSnippet String?
  isSolution Boolean @default(false)
  threadId String
  thread IssueThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  @@index([threadId,createdAt])
}
